# Indirizzo LAN del PC che ospita l'API del ristorante e llama-server.
RESTAURANT_API_URL=http://<PC1-LAN-IP>:8000
MODEL_BASE_URL=http://<PC1-LAN-IP>:8081/v1
MODEL_API_KEY=local

# Usa il nome modello restituito da /v1/models.
MODEL_NAME=local

REQUEST_TIMEOUT=180
MAX_TOOL_ROUNDS=8

# Origine dell'interfaccia PC3.
CORS_ORIGINS=http://localhost:8080
