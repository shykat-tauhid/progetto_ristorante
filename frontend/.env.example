RESTAURANT_API_URL=http://10.10.94.46:8000
MODEL_BASE_URL=http://10.10.94.46:8081/v1
MODEL_API_KEY=local
MODEL_NAME=local
REQUEST_TIMEOUT=180
MAX_TOOL_ROUNDS=8

# Se true, nome e telefono REALI vengono scritti nel DB (l'LLM vede comunque solo segnaposto).
# Se false, nel DB finiscono i segnaposto (massima privacy, ma prenotazione non utilizzabile).
STORE_REAL_PII=true

# STT locale
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
LANGUAGE=it

# TTS Piper (scarica .onnx e .onnx.json in models/)
PIPER_MODEL=models/it_IT-paola-medium.onnx
